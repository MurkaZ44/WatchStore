<UserControl x:Class="Kursach.View.DiscountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:Kursach.ViewModel"
             xmlns:viewModel1="clr-namespace:Kursach.ViewModel"
             xmlns:view="clr-namespace:Kursach.View"
             xmlns:converters="clr-namespace:Kursach.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <view:DiscountsViewModel/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <view:DiscountsViewModel x:Key="DiscountsViewModel"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Расчет оптимальной скидки"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <!-- Выбор товара -->
            <StackPanel Width="320">
                <TextBlock Text="Товар" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding AvailableProducts}"
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="DisplayName"
                          Width="300" Height="30" Margin="0,0,0,10"/>
                
                <TextBlock Text="{Binding SelectedProductDescription}"
                           TextWrapping="Wrap"
                           Width="300" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Параметры и результат -->
            <StackPanel Margin="40,0,0,0" Width="350">
                <TextBlock Text="Диапазон скидки" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="от:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding MinDiscount}" Width="60" Margin="0,0,10,0"/>
                    <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding MaxDiscount}" Width="60"/>
                </StackPanel>

                <Button Content="Рассчитать скидку"
                        Command="{Binding CalculateDiscountCommand}"
                        Margin="0,10,0,0"
                        Width="220" Height="30"/>
                
                <Button Content="Применить скидку"
                        Command="{Binding ApplyDiscountCommand}"
                        Margin="0,10,0,0"
                        Width="220" Height="30"/>

                <Button Content="Отменить скидку"
                        Command="{Binding CancelDiscountCommand}"
                        Margin="0,10,0,0"
                        Width="220" Height="30"
                        Visibility="{Binding SelectedProduct.AppliedDiscount, Converter={StaticResource NullToVisibilityConverter}}"/>

                <TextBlock Text="{Binding CalculatedDiscountText}"
                           Margin="0,10,0,0"
                           FontSize="16"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding ExpectedProfitText}"
                           Margin="0,5,0,0"
                           FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
