<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <Page Update="View\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.11" />
      <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
      <PackageReference Include="OxyPlot.Core" Version="2.1.2" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="View\watch.ico" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Media\watch.ico" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="View\Forms\NewSeller.cs">
        <DependentUpon>NewSeller.xaml</DependentUpon>
      </Compile>
      <Compile Update="View\Forms\NewSupplier.cs">
        <DependentUpon>NewSupplier.xaml</DependentUpon>
      </Compile>
      <Compile Update="View\ClientListView.cs">
        <DependentUpon>ClientListView.xaml</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
